# Copy to .env on the server and fill in.

DOMAIN=ooda.obrydd.com
SITE_URL=https://ooda.obrydd.com
ALLOWED_HOSTS=ooda.obrydd.com
CSRF_TRUSTED_ORIGINS=https://ooda.obrydd.com

# A long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Open https://ooda.obrydd.com/start/?key=<this> once to create the first owner.
SETUP_KEY=

# Let anyone create a new board at /signup/. Normally off: people join by invitation.
ALLOW_SIGNUP=false

TIME_ZONE=Europe/Stockholm

# E-mail over SMTP. Postmark example; Brevo and Scaleway TEM work the same way.
DEFAULT_FROM_EMAIL=OODA <ooda@obrydd.com>
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
